# Postgres connection (Coolify-managed Postgres in prod; local docker-compose.dev.yml in dev)
# This is the least-privilege runtime role in prod — it can't run DDL.
DATABASE_URL=postgres://nrighar:nrighar@localhost:5432/nrighar

# Privileged owner/DDL role used ONLY by db/migrate.ts (migrate-on-start).
# Set in prod to an owner/superuser connection; falls back to DATABASE_URL when
# unset (fine for local dev where DATABASE_URL is already a superuser).
# MIGRATION_DATABASE_URL=postgres://postgres:<pw>@localhost:5432/nrighar

# HTTP server
PORT=8080

# JWT access-token signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=changeme

# Comma-separated list of allowed CORS origins (web app + local dev)
CORS_ORIGINS=http://localhost:3000,https://nrighar.3pandalabs.com

# Bearer token for the ops-only GET /metrics endpoint scraped by the admin page.
# Must match the METRICS_TOKEN secret on the 3pandalabs-admin Worker (one shared
# token across all apps). Generate with: openssl rand -hex 32
# Leave blank to disable — /metrics then answers 503 and nothing else changes.
METRICS_TOKEN=

# Cloudflare R2 (S3-compatible). Bucket must be created ahead of time; see infra/README.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nrighar-documents
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# KYC document verification (only read by the Temporal worker process — see
# src/temporal/activities/kyc.ts). Without it, kyc-typed document uploads
# still get a kyc_verifications row, just with status "failed" and no
# extraction. Vision-capable Claude model; the default is a good tradeoff of
# quality vs cost for reading scanned ID documents.
ANTHROPIC_API_KEY=
ANTHROPIC_KYC_MODEL=claude-sonnet-5

# Official PAN/Aadhaar/passport verification providers are NOT wired up yet
# (see src/lib/kyc/officialVerify.ts) — every document currently lands in
# manual_review after extraction rather than auto-verified, pending a real
# licensed KYC-API provider integration.

# ---------------------------------------------------------------------------
# Paid external integrations (identity KYC, e-Sign, BBPS)
#
# All optional. None of them are required at boot — a missing key disables
# exactly one feature and surfaces as a `not_configured` status on the row the
# caller reads back, never as a boot failure and never as a fabricated
# "verified". See src/lib/providers/env.ts.
#
# Every provider below is swappable by env var alone; the adapter file is the
# only provider-aware code. That seam exists because per-call pricing between
# aggregators moves enough that being locked to one is a real cost.
# ---------------------------------------------------------------------------

# Identity KYC — PAN lookup and Aadhaar OTP. "surepass" | "none".
IDENTITY_KYC_PROVIDER=none
SUREPASS_BASE_URL=https://kyc-api.surepass.io/api/v1
SUREPASS_TOKEN=

# Aadhaar e-Sign. "leegality" | "none".
ESIGN_PROVIDER=none
LEEGALITY_BASE_URL=https://api.leegality.com/api/v3.0
LEEGALITY_AUTH_TOKEN=
# Shared secret the provider signs webhook bodies with. WITHOUT IT, EVERY
# WEBHOOK DELIVERY IS REJECTED — signature verification is the only
# authentication on POST /webhooks/esign, and its effect is to mark a lease as
# legally signed, so it fails closed rather than open.
LEEGALITY_WEBHOOK_SECRET=
# Public URL the provider posts completion callbacks to. Not derived from the
# request Host, for the same reason WEB_ORIGIN isn't.
ESIGN_WEBHOOK_URL=https://api.nrighar.3pandalabs.com/webhooks/esign

# BBPS bill fetch. "setu" | "none".
BBPS_PROVIDER=none
SETU_BASE_URL=https://prod.setu.co/api/v2
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

# HMAC key for number fingerprints AND the AES-GCM sealing of PAN/Aadhaar/OTP
# values before they enter a Temporal workflow argument (Temporal persists
# those in its event history). Generate with: openssl rand -hex 32
# Falls back to JWT_SECRET when unset, so it is never an unkeyed hash.
# Rotating it invalidates the verification cache; it loses no history.
KYC_FINGERPRINT_SECRET=

# Hard ceilings on billable calls per calendar month, per family. Reaching one
# returns 429 provider_quota_exceeded and skips the account in the cron. These
# are the last line of defence against a bug that loops — the caches, cooldowns
# and fetch gates are what keep normal usage far beneath them.
IDENTITY_KYC_MONTHLY_CAP=500
ESIGN_MONTHLY_CAP=200
BBPS_MONTHLY_CAP=1000

# How long a successful verification is reused instead of re-billed. A PAN
# holder's name doesn't change, hence the long default.
PAN_CACHE_DAYS=180
AADHAAR_CACHE_DAYS=30
# Cooldown between billable lookups on the same number, any caller.
IDENTITY_COOLDOWN_SECONDS=60
# How long a provider-side Aadhaar OTP session is reused instead of buying a
# new SMS. Kept under the usual 10-minute provider TTL so we never hand back a
# session that expires mid-submit.
AADHAAR_OTP_TTL_SECONDS=480
